# ===========================================
# TCG Store - Environment Configuration
# ===========================================
# Copy this file to .env and adjust values
# NEVER commit .env to version control!

# ─── Backend API ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api

# ─── API Mode ─────────────────────────────────────────────────────────────────
# true = Use real backend API
# false = Use localStorage (demo mode, no backend needed)
VITE_USE_API=true

# ─── PayPal Configuration ─────────────────────────────────────────────────────
# Get your sandbox credentials from https://developer.paypal.com/
# For production, use your live client ID
VITE_PAYPAL_CLIENT_ID=sb

# ─── Stripe Configuration ─────────────────────────────────────────────────────
# Get your keys from https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# ─── Bank Transfer Configuration ────────────────────────────────────────────
VITE_BANK_NAME=BBVA
VITE_BANK_CLABE=012345678901234567
VITE_BANK_CARD=**** **** **** 1234
VITE_BENEFICIARY=Your Name
VITE_WHATSAPP_NUMBER=+521234567890

# ─── Google OAuth ────────────────────────────────────────────────────────────────
# Get Client ID from Google Cloud Console (APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ─── External TCG APIs (Optional - for admin card import) ─────────────────
# Pokemon TCG API (free, no key required): https://pokemontcg.io/
# Scryfall API (free, no key required): https://scryfall.com/
# TCG Player API (requires API keys): https://developer.tcgplayer.com/
VITE_TCG_PUBLIC_KEY=your-tcgplayer-public-key
VITE_TCG_PRIVATE_KEY=your-tcgplayer-private-key
